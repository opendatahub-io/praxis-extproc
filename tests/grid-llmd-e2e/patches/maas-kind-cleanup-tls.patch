+func requireCronJobCommand(t *testing.T, cronJob *unstructured.Unstructured) string {
+	t.Helper()
+
+	containers, found, err := unstructured.NestedSlice(
+		cronJob.Object,
+		"spec", "jobTemplate", "spec", "template", "spec", "containers",
+	)
+	require.NoError(t, err)
+	require.True(t, found)
+	require.NotEmpty(t, containers)
+
+	container, ok := containers[0].(map[string]any)
+	require.True(t, ok)
+	command, ok := container["command"].([]any)
+	require.True(t, ok)
+	commandParts := make([]string, 0, len(command))
+	for _, part := range command {
+		if value, ok := part.(string); ok {
+			commandParts = append(commandParts, value)
+		}
+	}
+	return strings.Join(commandParts, "\n")
+}
