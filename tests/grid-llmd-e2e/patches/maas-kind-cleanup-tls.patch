+// MaaSAPIServingCertSecretName returns the Secret name shared by the generated
+// Certificate, Service annotation, and maas-api Deployment volume. Certificate
+// object names use the standard suffix form, while the Secret name keeps the
+// established maas-api-{tenant}-serving-cert form used by the Service and Pod.
+func MaaSAPIServingCertSecretName(tenantID string) string {
+	if tenantID == "" {
+		return baseMaaSAPIServingCertName
+	}
+	return fmt.Sprintf("maas-api-%s-serving-cert", tenantID)
+}
